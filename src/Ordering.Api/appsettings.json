{
  "ConnectionStrings": {
    "Ordering": "Server=localhost,1433;Database=Ordering;User Id=sa;Password=Ordering!Passw0rd;TrustServerCertificate=True;Encrypt=False"
  },
  "Snowflake": {
    "WorkerId": 0
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {RequestId} {IdempotencyKey} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
