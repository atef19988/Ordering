{
  "ConnectionStrings": {
    "Ordering": "Server=localhost,1433;Database=Ordering;User Id=sa;Password=Ordering!Passw0rd;TrustServerCertificate=True;Encrypt=False"
  },
  "Snowflake": {
    "WorkerId": 0
  },
  "Database": {
    "InitializeOnStartup": false
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Redis": {
    "Configuration": "localhost:6379,abortConnect=false",
    "InstanceName": "ordering:"
  },
  "Sse": {
    "MaxConnectionSeconds": 300,
    "MaxConnections": 1000
  },
  "Notifications": {
    "Delivery": {
      "FailureMode": "None",
      "FailFirstN": 2,
      "FailureRate": 0.3,
      "LatencyMs": 50
    },
    "Relay": {
      "PollIntervalMs": 200,
      "BatchSize": 200,
      "LeaseSeconds": 30,
      "ReaperIntervalSeconds": 60,
      "PublishedTimeoutSeconds": 300
    },
    "Consumer": {
      "Prefetch": 50,
      "MaxAttempts": 5,
      "BaseBackoffMs": 200,
      "MaxBackoffMs": 30000
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {RequestId} {IdempotencyKey} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
